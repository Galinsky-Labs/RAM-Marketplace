# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ram_marketplace
RAM_DATA_BACKEND=postgres

# Signed session cookies. Use a long random value in deployed environments.
AUTH_SECRET=replace-with-a-long-random-secret

# Verified external identity boundary. The assertion secret must be distinct
# from AUTH_SECRET and shared only with the trusted identity gateway.
RAM_IDENTITY_ASSERTION_SECRET=replace-with-a-separate-long-random-secret
RAM_IDENTITY_ALLOWED_PROVIDERS=enterprise-oidc
RAM_IDENTITY_LOGIN_URL=https://identity.example.com/login
RAM_IDENTITY_REQUIRE_MFA=true


# Provider-neutral payment execution gateway. Use a separate signing secret.
# The gateway receives signed idempotent execution instructions and posts
# signed status webhooks back to /api/payments/webhook.
RAM_PAYMENT_GATEWAY_NAME=production-gateway
RAM_PAYMENT_GATEWAY_URL=https://payments.example.com
RAM_PAYMENT_GATEWAY_SECRET=replace-with-a-separate-payment-gateway-secret
RAM_PAYMENT_GATEWAY_ALLOW_INSECURE_LOCAL=false


# Operational monitoring. The scheduler token and alert signing secret must be
# strong, distinct from every other RAM secret, and rotated independently.
RAM_MONITORING_ENABLED=true
RAM_MONITORING_RUN_TOKEN=replace-with-a-separate-monitoring-run-token
RAM_MONITORING_ALERT_WEBHOOK_URL=https://alerts.example.com/ram
RAM_MONITORING_ALERT_WEBHOOK_SECRET=replace-with-a-separate-monitoring-alert-secret
RAM_MONITORING_ALLOW_INSECURE_LOCAL=false
RAM_MONITORING_PAYMENT_UNKNOWN_MINUTES=10
RAM_MONITORING_PAYMENT_PROCESSING_MINUTES=60
RAM_MONITORING_DISPUTE_HOURS=24
RAM_MONITORING_PICKUP_HOURS=24
RAM_MONITORING_ORG_VERIFICATION_HOURS=48
RAM_MONITORING_MAX_RUN_AGE_MINUTES=15

# Unverified public self-onboarding is disabled by default in production.
RAM_PUBLIC_ONBOARDING_ENABLED=false

# Demo role login is automatically available in local development.
# Set true explicitly on a controlled demo deployment if desired.
RAM_DEMO_AUTH_ENABLED=false


# Maximum Content-Length accepted for unsafe API methods.
# Default: 1048576 (1 MiB). Keep ordinary structured workflow requests small.
RAM_MAX_MUTATION_BYTES=1048576

# Recommended infrastructure controls outside the application:
# - TLS termination with trusted Host forwarding
# - edge/WAF request throttling in addition to application onboarding/demo limits
# - PostgreSQL encryption/backups and restricted network access

# Transport corridor rules (RAM-04/RAM-05). When true, transport assignment
# requires origin/destination state codes and a published, in-effect corridor
# rule (deny by default). Required for a real pilot; leave false for the demo.
RAM_CORRIDOR_RULES_ENFORCED=false

# Diagnostic laboratory integration. Disabled (503) until both are set.
# The lab signs each report: HMAC-SHA256("<unix ts>.<raw body>") in
# x-ram-diagnostics-signature, timestamp in x-ram-diagnostics-timestamp.
RAM_DIAGNOSTICS_PROVIDER_NAME=
RAM_DIAGNOSTICS_WEBHOOK_SECRET=

# Standards-based enterprise SSO (OIDC). Off until all four are set. See docs/IDENTITY_OIDC.md.
RAM_OIDC_ISSUER=
RAM_OIDC_CLIENT_ID=
RAM_OIDC_CLIENT_SECRET=
RAM_OIDC_REDIRECT_URI=
RAM_OIDC_PROVIDER_NAME=oidc
RAM_OIDC_MFA_ACR_VALUES=

# Stripe adapter (alternative to RAM_PAYMENT_GATEWAY_*; never both). Off without keys.
# Live keys also require RAM_STRIPE_ALLOW_LIVE=true. See docs/PAYMENTS_STRIPE.md.
RAM_STRIPE_SECRET_KEY=
RAM_STRIPE_WEBHOOK_SECRET=
RAM_STRIPE_ALLOW_LIVE=false

# In-process monitoring interval in minutes (5-1440); requires RAM_MONITORING_ENABLED=true.
RAM_MONITORING_INPROCESS_INTERVAL_MINUTES=
